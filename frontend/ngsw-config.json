{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/icons/**", "/data/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "published-data",
      "urls": ["https://raw.githubusercontent.com/**"],
      "cacheConfig": { "strategy": "freshness", "timeout": "5s", "maxAge": "30d", "maxSize": 20 }
    },
    {
      "name": "fonts",
      "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"],
      "cacheConfig": { "strategy": "performance", "maxAge": "365d", "maxSize": 30 }
    }
  ]
}
